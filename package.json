{
  "name": "dsh-doraemon",
  "version": "0.5.15",
  "description": "Windows computer-use plugin for DeepSeek Harness (DSH): UIA, local OCR, window binding, browser automation and visual grounding.",
  "keywords": [
    "deepseek-harness",
    "deepseek",
    "dsh",
    "dsh-plugin",
    "windows",
    "computer-use",
    "desktop-automation",
    "gui-automation",
    "uia",
    "ocr",
    "browser-automation",
    "gui-agent"
  ],
  "private": false,
  "os": [
    "win32"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "host-config.js",
    "runtime-host.js",
    "client.js",
    "companion-state.js",
    "bridge-client.js",
    "cursor-state.js",
    "kernel.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "QUICKSTART.md",
    "CHANGELOG.md",
    "requirements.txt",
    "requirements-vision.txt",
    "kernel/dsh_desktop/__init__.py",
    "kernel/dsh_desktop/actions.py",
    "kernel/dsh_desktop/browser.py",
    "kernel/dsh_desktop/browser_support.py",
    "kernel/dsh_desktop/companion.py",
    "kernel/dsh_desktop/conditions.py",
    "kernel/dsh_desktop/config.py",
    "kernel/dsh_desktop/contracts.py",
    "kernel/dsh_desktop/cursor_feedback.py",
    "kernel/dsh_desktop/cursor_overlay.py",
    "kernel/dsh_desktop/cursor_theme.py",
    "kernel/dsh_desktop/decorations.py",
    "kernel/dsh_desktop/desktop_tools.py",
    "kernel/dsh_desktop/dom.py",
    "kernel/dsh_desktop/dpi.py",
    "kernel/dsh_desktop/dsh_bridge.py",
    "kernel/dsh_desktop/dsh_bridge_cli.py",
    "kernel/dsh_desktop/file_search.py",
    "kernel/dsh_desktop/geometry.py",
    "kernel/dsh_desktop/input_gate.py",
    "kernel/dsh_desktop/journal.py",
    "kernel/dsh_desktop/mascot_theme.py",
    "kernel/dsh_desktop/mem_track.py",
    "kernel/dsh_desktop/observations.py",
    "kernel/dsh_desktop/oklch.py",
    "kernel/dsh_desktop/operations.py",
    "kernel/dsh_desktop/runtime.py",
    "kernel/dsh_desktop/targets.py",
    "kernel/dsh_desktop/tool_decorator.py",
    "kernel/dsh_desktop/ui_parser.py",
    "kernel/dsh_desktop/version.py",
    "kernel/dsh_desktop/window_glow.py",
    "kernel/dsh_desktop/window_identity.py",
    "kernel/dsh_desktop/worker.py",
    "kernel/dsh_desktop/game/*.py",
    "kernel/dsh_desktop/assets/cursor_whale_maid/*.png",
    "kernel/dsh_desktop/assets/cursor_whale_maid/manifest.json",
    "kernel/dsh_desktop/assets/whale_commander/*.png",
    "scripts/bootstrap.ps1",
    "scripts/reload-cursor-kernel.ps1",
    "scripts/install-elevated-task.ps1",
    "scripts/run-kernel-high.py",
    "scripts/build-companion-ui.ps1",
    "companion/*.cs",
    "companion/*.csproj",
    "THIRD_PARTY_NOTICES.txt",
    "docs/MIGRATION-0.5.md",
    "docs/commander-mode.md",
    "docs/data-boundary.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.5 <4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "license": "MIT",
  "author": "Mrkennyhungry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mrkennyhungry/dsh-cua.git"
  },
  "bugs": {
    "url": "https://github.com/Mrkennyhungry/dsh-cua/issues"
  },
  "homepage": "https://github.com/Mrkennyhungry/dsh-cua#readme"
}
